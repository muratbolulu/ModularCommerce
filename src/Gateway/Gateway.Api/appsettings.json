{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "auth-root-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "product-root-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/products"
        }
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/logs/{**catch-all}"
        }
      },
      "log-root-route": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/logs"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5297/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5124/"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5092/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
