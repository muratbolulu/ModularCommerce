{
  "info": {
    "_postman_id": "69be2b6e-a786-445c-8515-f904f66c5f5e",
    "name": "ModularCommerce - Gateway + Catalog Saga",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Gateway uzerinden Product ve Catalog Saga akis testi."
  },
  "item": [
    {
      "name": "0 - Gateway Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "1 - Auth Login (Get Access Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.expect(data).to.have.property('accessToken');",
              "pm.collectionVariables.set('accessToken', data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "2 - Create Product (Saga Trigger)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Keyboard-{{$timestamp}}\",\n  \"price\": 1250,\n  \"stock\": 12\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create product status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.expect(data).to.have.property('id');",
              "pm.collectionVariables.set('productId', data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "3 - Update Product (Saga Trigger)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Keyboard-Pro-{{$timestamp}}\",\n  \"price\": 1490,\n  \"stock\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Update product status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "4 - Get Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5 - Get Catalog Items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/catalog/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "catalog",
            "items"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Catalog items status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const items = pm.response.json();",
              "pm.test('Catalog contains synced product', function () {",
              "    pm.expect(items.some(x => x.productId === pm.collectionVariables.get('productId'))).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "6 - Get Catalog Sagas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/catalog/sagas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "catalog",
            "sagas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Catalog sagas status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const sagas = pm.response.json();",
              "const productId = pm.collectionVariables.get('productId');",
              "const productSagas = sagas.filter(x => x.productId === productId);",
              "pm.test('Saga exists for product', function () {",
              "    pm.expect(productSagas.length).to.be.above(0);",
              "});",
              "",
              "pm.test('At least one saga is completed', function () {",
              "    pm.expect(productSagas.some(x => x.state === 'Completed')).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "7 - Force Catalog Failure (Negative Price Update)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Keyboard-Failure-{{$timestamp}}\",\n  \"price\": -50,\n  \"stock\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{productId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Failure trigger update status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.collectionVariables.set('failureProductId', pm.collectionVariables.get('productId'));",
              "pm.collectionVariables.set('failureSagaRetryCount', '0');",
              "pm.collectionVariables.set('softDeleteRetryCount', '0');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "8 - Verify Failure Saga (Auto Retry)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/catalog/sagas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "catalog",
            "sagas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Catalog sagas status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const sagas = pm.response.json();",
              "const productId = pm.collectionVariables.get('failureProductId');",
              "const maxRetries = parseInt(pm.collectionVariables.get('maxFailureRetries') || '10', 10);",
              "let retryCount = parseInt(pm.collectionVariables.get('failureSagaRetryCount') || '0', 10);",
              "",
              "const failedSaga = sagas.find(x => x.productId === productId && x.state === 'Failed');",
              "if (failedSaga) {",
              "    pm.collectionVariables.set('failureSagaVerified', 'true');",
              "    pm.collectionVariables.set('failureSagaRetryCount', '0');",
              "    pm.test('Failure saga detected for product', function () {",
              "        pm.expect(failedSaga).to.not.eql(undefined);",
              "    });",
              "} else if (retryCount < maxRetries) {",
              "    retryCount += 1;",
              "    pm.collectionVariables.set('failureSagaRetryCount', String(retryCount));",
              "    postman.setNextRequest('8 - Verify Failure Saga (Auto Retry)');",
              "} else {",
              "    pm.test('Failure saga detected for product', function () {",
              "        pm.expect.fail('Failure saga did not reach Failed state within retry limit');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "9 - Verify Product Soft-Deleted (Auto Retry)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Products status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const products = pm.response.json();",
              "const productId = pm.collectionVariables.get('failureProductId');",
              "const maxRetries = parseInt(pm.collectionVariables.get('maxFailureRetries') || '10', 10);",
              "let retryCount = parseInt(pm.collectionVariables.get('softDeleteRetryCount') || '0', 10);",
              "",
              "const exists = products.some(x => x.id === productId);",
              "if (!exists) {",
              "    pm.collectionVariables.set('softDeleteVerified', 'true');",
              "    pm.collectionVariables.set('softDeleteRetryCount', '0');",
              "    pm.test('Product is soft-deleted and filtered from list', function () {",
              "        pm.expect(exists).to.eql(false);",
              "    });",
              "} else if (retryCount < maxRetries) {",
              "    retryCount += 1;",
              "    pm.collectionVariables.set('softDeleteRetryCount', String(retryCount));",
              "    postman.setNextRequest('9 - Verify Product Soft-Deleted (Auto Retry)');",
              "} else {",
              "    pm.test('Product is soft-deleted and filtered from list', function () {",
              "        pm.expect.fail('Product still visible in list after retry limit');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    }
  ],
